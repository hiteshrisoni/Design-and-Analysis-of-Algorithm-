Use structures to store the roll number, name and marks in five subjects for N students. Calculate total, percentage and grade. Display the topper, failed students and class average.
#include <stdio.h>

struct Student {
    int rollNo;
    char name[50];
    float marks[5];
    float total;
    float percentage;
    char grade;
};

char calculateGrade(float percentage) {

    if (percentage >= 90)
        return 'A';
    else if (percentage >= 80)
        return 'B';
    else if (percentage >= 70)
        return 'C';
    else if (percentage >= 60)
        return 'D';
    else if (percentage >= 50)
        return 'E';
    else
        return 'F';
}

int main() {

    int n;

    printf("Enter number of students: ");
    scanf("%d", &n);

    struct Student students[n];

    float classTotal = 0;

    for (int i = 0; i < n; i++) {

        printf("\nEnter details of student %d\n", i + 1);

        printf("Roll number: ");
        scanf("%d", &students[i].rollNo);

        printf("Name: ");
        scanf(" %[^\n]", students[i].name);

        students[i].total = 0;

        printf("Enter marks of 5 subjects:\n");

        for (int j = 0; j < 5; j++) {
            scanf("%f", &students[i].marks[j]);
            students[i].total += students[i].marks[j];
        }

        students[i].percentage = students[i].total / 5;

        students[i].grade =
            calculateGrade(students[i].percentage);

        classTotal += students[i].percentage;
    }

    int topper = 0;

    for (int i = 1; i < n; i++) {

        if (students[i].percentage >
            students[topper].percentage) {

            topper = i;
        }
    }

    printf("\n===== STUDENT RESULTS =====\n");

    for (int i = 0; i < n; i++) {

        printf("\nRoll Number: %d",
               students[i].rollNo);

        printf("\nName: %s",
               students[i].name);

        printf("\nTotal: %.2f",
               students[i].total);

        printf("\nPercentage: %.2f%%",
               students[i].percentage);

        printf("\nGrade: %c\n",
               students[i].grade);
    }

    printf("\n===== CLASS TOPPER =====\n");

    printf("Name: %s\n",
           students[topper].name);

    printf("Roll Number: %d\n",
           students[topper].rollNo);

    printf("Percentage: %.2f%%\n",
           students[topper].percentage);

    printf("\n===== FAILED STUDENTS =====\n");

    int failedFound = 0;

    for (int i = 0; i < n; i++) {

        int failed = 0;

        for (int j = 0; j < 5; j++) {

            if (students[i].marks[j] < 40) {
                failed = 1;
                break;
            }
        }

        if (failed) {
            printf("%s\n", students[i].name);
            failedFound = 1;
        }
    }

    if (!failedFound)
        printf("No student failed.\n");

    printf("\nClass Average: %.2f%%\n",
           classTotal / n);

    return 0;
}
