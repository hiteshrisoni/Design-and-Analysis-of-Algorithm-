Check whether a given string is a palindrome while ignoring spaces and differences between uppercase and lowercase letters.
#include <stdio.h>
#include <string.h>
#include <ctype.h>

int main() {
    char str[200];
    char clean[200];

    printf("Enter a string: ");
    fgets(str, sizeof(str), stdin);

    int j = 0;

    for (int i = 0; str[i] != '\0'; i++) {

        if (str[i] != ' ') {
            clean[j++] = tolower(str[i]);
        }
    }

    clean[j] = '\0';

    int left = 0;
    int right = j - 1;
    int palindrome = 1;

    while (left < right) {

        if (clean[left] != clean[right]) {
            palindrome = 0;
            break;
        }

        left++;
        right--;
    }

    if (palindrome)
        printf("The string is a palindrome.\n");
    else
        printf("The string is not a palindrome.\n");

    return 0;
}
